# The same pipeline as the Makefile: snakemake --cores 1


rule all:
    input:
        "build/evaluate.id",


rule prepare:
    input:
        "prepare.py",
    output:
        "build/points.id",
    shell:
        "python prepare.py > {output}"


rule fit:
    input:
        "fit.py",
        points="build/points.id",
    output:
        "build/fit.id",
    shell:
        "python fit.py $(cat {input.points}) > {output}"


rule evaluate:
    input:
        "evaluate.py",
        fit="build/fit.id",
        points="build/points.id",
    output:
        "build/evaluate.id",
    shell:
        "python evaluate.py $(cat {input.fit}) $(cat {input.points}) > {output}"
